{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts", 
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "tests",
    "jest.config.js"
  ]
}